{
  "name": "nqu-campus-week7",
  "version": "1.0.0",
  "private": true,
  "description": "金門大學校務系統示範網站，附單元測試、系統測試與 Playwright E2E 測試",
  "keywords": [
    "campus",
    "nqu",
    "student-information-system",
    "testing",
    "playwright",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:system",
    "test:unit": "node --test \"dist/test/unit/*.test.js\"",
    "test:system": "node --test \"dist/test/system/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"dist/test/unit/*.test.js\" \"dist/test/system/*.test.js\"",
    "test:e2e": "npm run build && node scripts/reset-e2e.mjs && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "start": "node dist/src/server.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
