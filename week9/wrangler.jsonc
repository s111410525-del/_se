// wrangler 設定：https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgememo",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",

  // D1：部署前先建立資料庫，並把 database_id 換成實際值
  //   npx wrangler d1 create edgememo-db
  //   npx wrangler d1 execute edgememo-db --remote --file=schema.sql
  //   npx wrangler d1 execute edgememo-db --remote --file=seed.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgememo-db",
      "database_id": "172151a0-8bea-4a92-bd21-7911dcddcd4a"
    }
  ],

  // 前端是純靜態檔案；/api/* 先交給 Worker，其餘由 Assets 提供。
  // 找不到的無副檔名路徑由 Worker 回傳 index.html（SPA 路由）；
  // 缺少的靜態檔仍維持 404。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
