{
  "name": "edgememo",
  "version": "1.0.0",
  "private": true,
  "description": "EdgeMemo：在 Cloudflare Workers + D1 上運行的備忘錄網站",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/worker.js && node --check public/app.js",
    "db:local": "wrangler d1 execute edgememo-db --local --file=schema.sql",
    "seed:local": "wrangler d1 execute edgememo-db --local --file=seed.sql",
    "setup:local": "npm run db:local && npm run seed:local"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
